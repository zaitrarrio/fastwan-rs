# Cargo. Cargo.lock stays: this workspace builds the `fastwan` binary.
# Unanchored so a crate built outside the workspace (`crates/* /target`)
# is ignored too. Profiles live under target/, including debug and release.
target/
**/*.rs.bk
*.pdb

# rust-analyzer, sccache, nextest, and a vendored crate tree.
.ra-x/
.sccache/
.nextest/
/vendor/

# Downloaded checkpoints (`huggingface-cli download … --local-dir fastwan`)
# and a local checkout of the TAEHV reference. Weights live in R2, not git.
/fastwan/
/taehv/
/fastwan-runs/
.cache/
.huggingface/

# Taskfile.yml checksums.
.task/

# `task embed` writes gallery.json here; the safetensors are already ignored.
/gallery/

# Generated checkpoints, quantized exports, prompt embeddings, and other
# weight formats. The tiny transformers/diffusers fixtures under
# crates/*/tests/fixtures/ are checked in.
*.safetensors
!crates/**/fixtures/*.safetensors
*.pt
*.pth
*.bin
*.ckpt
*.onnx
*.pb
*.gguf
*.tflite
*.npy
*.npz
*.msgpack
*.h5
*.hdf5
*.part
*.incomplete

# CLI frame dump (`--out` defaults to out.y4m) and clips written at the repo
# root. Measurement clips and stills under docs/runs/ stay tracked.
*.y4m
*.yuv
/out/
/*.mp4
/*.webm
/*.mov
/*.mkv
/*.avi
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
/*.wav
/*.flac

# `python3 web/build.py` output. The sources are web/*.html, the shaders,
# and web/fastwan-webgpu-bench.html (regenerated, but checked in: the
# `web_page_embeds_current_shaders` test fails when it is stale).
/web/dist/
/web/site/
/web/pkg/
/web/pkg-*/

# Cloudflare (wrangler cache, Pages local state, Worker secrets).
.wrangler/
.dev.vars
.dev.vars.*
.mf/

# Python (scripts/, web/build.py, scripts/reference/make_fixtures.py).
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pyenv-version
.envrc
.direnv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/
.python-version
*.egg
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
__pypackages__/

# Playwright (scripts/vast/page_test.py). Screenshot paths passed on the
# command line are not ignored; the tool's own report dirs are.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

